NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres
INTERNAL_API_SECRET=choose-a-dedicated-internal-api-secret
# Optional for service-role flows such as e2e auth seeding and handbook signing.
SUPABASE_SECRET_KEY=your-secret-key
DOCS_HUB_PASSWORD=choose-a-password-for-the-handbook
# Optional: enable the Inbox LLM interpreter. When omitted, Inbox falls back to the
# deterministic parser for interpretation.
OPENAI_API_KEY=your-openai-api-key
INBOX_LLM_ENABLED=false
INBOX_LLM_MODEL=gpt-5-mini
INBOX_LLM_TIMEOUT_MS=12000
INBOX_LLM_MAX_RETRIES=2
INBOX_LLM_RETRY_BASE_DELAY_MS=400
