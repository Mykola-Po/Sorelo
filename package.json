{
  "name": "sorela",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/prepare-next-build.mjs",
    "build": "next build",
    "start": "next start",
    "verify": "npm run lint && npm run typecheck && npm run db:check && npm run test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "ops:inbox:check": "node scripts/check-inbox-runtime.mjs",
    "backup:bundle": "node scripts/backup-repo.mjs"
  },
  "dependencies": {
    "@radix-ui/react-icons": "1.3.2",
    "@radix-ui/themes": "3.3.0",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.98.0",
    "@t3-oss/env-nextjs": "^0.13.10",
    "@use-gesture/react": "10.3.1",
    "drizzle-orm": "^0.45.1",
    "graphology": "0.26.0",
    "next": "^16.1.6",
    "postgres": "^3.4.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sigma": "3.0.2",
    "zod": "^4.3.6",
    "zustand": "5.0.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.0.18",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.1.6",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
